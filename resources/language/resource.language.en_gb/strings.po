msgctxt "#30617"
msgid "Database Maintenance"
msgstr ""

msgctxt "#30618"
msgid "Enabled adds an automatic database backup reminder when performing certain database maintenance activities. Default is ensabled."
msgstr ""

msgctxt "#30619"
msgid "Enabled adds an additional menu option for validating whether video artwork items exist and an option for cleaning missing artwork.  Default is disabled."
msgstr ""

msgctxt "#30620"
msgid "Enabled provides detailed artwork validation logging for success, failures and URL based skips.  Disabled only logs artwork validation failures.  Default is disabled."
msgstr ""

msgctxt "#30621"
msgid "Do you want to permanently delete these artork entries ?  This action can only be undone by restoring your Kodi DB."
msgstr ""

msgctxt "#30622"
msgid "Enable to reduce path table strictness and check for path entries with just missing parent paths.  See KS Cleaner Wiki for more information.  The default is disabled."
msgstr ""

msgctxt "#30623"
msgid "Enter a new value for your local Kodi video DB file name to override the default.  This is normally left default except during alpha and beta testing. See the KS Cleaner Wiki for more details"
msgstr ""


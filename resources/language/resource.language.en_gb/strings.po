msgctxt "#30600"
msgid "Select the number of database backups to keep.  The range is 1-20.  10 is the default. 0 is no limit."
msgstr ""

msgctxt "#30601"
msgid "Select the database type Kodi is using.  The default is Kodi local."
msgstr ""

msgctxt "#30602"
msgid "Enable to enforce file table entries are matched to movies, music and music video table entries.  See KS Cleaner Wiki for more information.  The default is disabled."
msgstr ""

msgctxt "#30603"
msgid "Enter a new value for your MySQL video DB name to override your advancedsettings.xml file name or default.  See the KS Cleaner Wiki for more details"
msgstr ""

msgctxt "#30604"
msgid "Enter a new value for your MySQL music DB name to override your advancedsettings.xml file name or default.  See the KS Cleaner Wiki for more details"
msgstr ""

msgctxt "#30605"
msgid "Enables an option to clean all tables from a single menu selection.  Default is disabled."
msgstr ""

msgctxt "#30606"
msgid "Enables an option to verify and repair missing music database triggers.  On is automatic repair.  Notify provides a GUI notification.  Default is Off."
msgstr ""

msgctxt "#30607"
msgid "Enables and select output format for duplicate media analysis.  Options are GUI, text file, both or off. Default is GUI."
msgstr ""

msgctxt "#30608"
msgid "Normal episode duplicate analysis compares the TV Show, Season and Episode.  Enhanced adds the epsiode first aired time.  This is to handle situatuions when multiple TV Shows do not have a unique TV Show name.  Default is disabled."
msgstr ""

msgctxt "#30609"
msgid "Enables and select output format for video media analysis.  This will provide a menu option to analyze all video database tables without cleaning.  Options are GUI, text file, both or off. Default is GUI."
msgstr ""

msgctxt "#30610"
msgid "Enabled keeps all copies of analysis text files and CSV output files.  Disabled only keeps the copies during the current KS Cleaner session and old files are deleted when the addon restarts.  Default is enabled."
msgstr ""

msgctxt "#30611"
msgid "Selct color for database records which will be cleaned.  Blue is default."
msgstr ""

